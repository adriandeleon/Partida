{
  "name": "Sublime Text",
  "notation": "cua",
  "bindings": {
    "palette.show": "Ctrl+Shift+P",
    "app.settings": "Ctrl+,",
    "app.quit": "Ctrl+Q",
    "library.addFolder": "Ctrl+O",
    "tool.systems": "Ctrl+K Ctrl+B",
    "tool.retroarch": "Ctrl+BACK_QUOTE",
    "view.toggleZenMode": "Ctrl+Shift+F11",
    "view.toggleExpertMode": "Ctrl+Shift+F12",
    "library.filter": "Ctrl+K Ctrl+F",
    "find.show": [
      "Ctrl+F",
      "F3"
    ],
    "find.previous": "Shift+F3",
    "view.uiZoomIn": "Shortcut+Alt+=",
    "view.uiZoomOut": "Shortcut+Alt+-",
    "view.uiZoomReset": "Shortcut+Alt+0",
    "window.focusNextRegion": "F6",
    "window.focusPreviousRegion": "Shift+F6",
    "view.zoomIn": "Shortcut+=",
    "view.zoomOut": "Shortcut+-",
    "view.zoomReset": "Shortcut+0"
  }
}
