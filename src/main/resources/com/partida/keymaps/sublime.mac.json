{
  "name": "Sublime Text",
  "notation": "cua",
  "bindings": {
    "palette.show": "Cmd+Shift+P",
    "app.settings": "Cmd+,",
    "app.quit": "Cmd+Q",
    "library.addFolder": "Cmd+O",
    "tool.systems": "Cmd+K Cmd+B",
    "tool.retroarch": "Ctrl+BACK_QUOTE",
    "view.toggleZenMode": "Cmd+Shift+F11",
    "view.toggleExpertMode": "Cmd+Shift+F12",
    "library.filter": "Cmd+K Cmd+F",
    "find.show": [
      "Cmd+F",
      "F3"
    ],
    "find.previous": "Shift+F3",
    "view.uiZoomIn": "Cmd+Alt+=",
    "view.uiZoomOut": "Cmd+Alt+-",
    "view.uiZoomReset": "Cmd+Alt+0",
    "window.focusNextRegion": "F6",
    "window.focusPreviousRegion": "Shift+F6",
    "view.zoomIn": "Cmd+=",
    "view.zoomOut": "Cmd+-",
    "view.zoomReset": "Cmd+0"
  }
}
